<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>RestoryTweaks</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0436;CS8632</NoWarn>

    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Restory</GameDir>
    <!-- Split out so CI can point at stripped reference assemblies instead of a real install. -->
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(GameDir)\Restory_Data\Managed</ManagedDir>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <!-- Loader + patching -->
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath></Reference>

    <!-- The game. Assembly-CSharp holds almost nothing; the real code is Restory.Assembly. -->
    <Reference Include="Restory.Assembly"><HintPath>$(ManagedDir)\Restory.Assembly.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath></Reference>
    <!-- Holds TextureMaskHolder, which carries the dirt texture on every element. -->
    <Reference Include="PWSMechanic"><HintPath>$(ManagedDir)\PWSMechanic.dll</HintPath></Reference>

    <!-- Unity -->
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath></Reference>

    <!-- Libraries the game's own API surfaces. Zenject matters: managers are dependency-injected
         rather than singletons, so reaching them needs the container. -->
    <Reference Include="Zenject"><HintPath>$(ManagedDir)\Zenject.dll</HintPath></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(ManagedDir)\Unity.InputSystem.dll</HintPath></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath></Reference>
    <Reference Include="DOTween"><HintPath>$(ManagedDir)\DOTween.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath></Reference>

    <!-- The game's data objects (ElementInfo and friends) derive from Odin's
         SerializedScriptableObject, so these are needed to see their base types at all. -->
    <Reference Include="Sirenix.Serialization"><HintPath>$(ManagedDir)\Sirenix.Serialization.dll</HintPath></Reference>
    <Reference Include="Sirenix.OdinInspector.Attributes"><HintPath>$(ManagedDir)\Sirenix.OdinInspector.Attributes.dll</HintPath></Reference>
    <Reference Include="Sirenix.Utilities"><HintPath>$(ManagedDir)\Sirenix.Utilities.dll</HintPath></Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Update="@(Reference)"><Private>false</Private></Reference>
  </ItemGroup>

</Project>
